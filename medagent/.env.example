# =============================================================================
# Autonomous Medical Imaging Diagnosis & Clinical Decision Agent
# .env.example — copy to `.env` and fill in real values. Never commit `.env`.
#
# Loaded via pydantic-settings in src/medagent/utils/settings.py. Every key
# here should have a matching field so a missing/blank value fails fast at
# startup rather than surfacing as a confusing runtime error deep in a graph
# node.
# =============================================================================

# --- App / Runtime ---
APP_ENV=development                  # development | staging | production
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
DEVICE=mps                           # cpu | mps (Apple Silicon) | cuda
OFFLINE_MODE=true                    # if true, agents must not call external network APIs
RANDOM_SEED=42

# --- LLM Providers ---
# Local-first: Ollama is the default runtime for the hackathon demo so the
# whole pipeline can run offline. Cloud keys are optional fallbacks/judges.
LLM_PROVIDER=ollama                  # ollama | huggingface | anthropic | openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct

HUGGINGFACE_HUB_TOKEN=               # required only for gated checkpoints (e.g. Llama-3 weights)
HF_HOME=./models/checkpoints/.hf_cache

ANTHROPIC_API_KEY=                   # optional: used as the DeepEval / Verifier "judge" model
OPENAI_API_KEY=                      # optional: fallback LLM + embeddings provider

# --- RAG / Evidence Sources ---
SEMANTIC_SCHOLAR_API_KEY=            # optional: raises Semantic Scholar's public rate limit
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1

# --- Vector Store (FAISS) ---
FAISS_INDEX_DIR=./vectorstore/faiss_index
FAISS_INDEX_NAME=medagent_guidelines

# --- Experiment Tracking / Evaluation ---
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=medagent-hackathon

DEEPEVAL_API_KEY=                    # optional: only needed for Confident AI cloud dashboard sync
ARIZE_PHOENIX_ENDPOINT=http://localhost:6006

# --- Privacy / PHI Redaction ---
PHI_REDACTION_ENABLED=true
PHI_REDACTION_SALT=                  # random string used to salt hashed patient/case identifiers

# --- Human-in-the-Loop ---
REQUIRE_CLINICIAN_APPROVAL=true
MAX_REPORT_REVISION_CYCLES=2

# --- UI (Streamlit) ---
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
